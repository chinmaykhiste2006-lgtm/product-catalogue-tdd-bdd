{
  "name": "product-catalogue-tdd-bdd",
  "version": "1.0.0",
  "private": true,
  "description": "Example REST product catalogue with Jest TDD and Cucumber/Selenium BDD",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --runInBand",
    "test:bdd": "cucumber-js --require features/support/*.js --require features/step_definitions/*.js features/products.feature",
    "check": "npm test"
  },
  "dependencies": {
    "express": "^4.21.2",
    "sequelize": "^6.37.5",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@faker-js/faker": "^9.9.0",
    "axios": "^1.9.0",
    "jest": "^29.7.0",
    "selenium-webdriver": "^4.31.0",
    "supertest": "^7.0.0"
  },
  "jest": {"testEnvironment": "node", "testMatch": ["**/tests/**/*.test.js"], "setupFilesAfterEnv": ["<rootDir>/tests/setup.js"]}
}
